<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

  <mapper namespace="org.doit.goodpang.mapper.AdminMapper">

	<!-- public AdminDTO findByAdminId(String adminId); -->
	<select id="findByAdminId" resultType="org.doit.goodpang.domain.AdminDTO">
            SELECT ADMIN_NO, ADMIN_ID, ADMIN_PW, ADMIN_NAME, EMAIL, TEL
            FROM ADMIN
            WHERE ADMIN_ID = #{adminId}
	</select>

</mapper>
