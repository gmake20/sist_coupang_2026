<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.doit.goodpang.mapper.WowMembershipMapper">

    <select id="isWowMember"
            resultType="int">

        SELECT COUNT(*)
        FROM WOW_MEMBERSHIP
        WHERE MEMBER_NO = #{memberNo}

    </select>

</mapper>