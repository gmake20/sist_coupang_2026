<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC 
   "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN" 
   "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">

<tiles-definitions>

	<!-- shop 레이아웃 - 헤더 + 본문 + 푸터 페이지 추가할 때 아래 home.index 처럼 definition 만 더 
		쓰면 됨. -->
	<definition name="shop" template="/WEB-INF/views/inc/layout_shop.jsp">
		<put-attribute name="header" value="/WEB-INF/views/inc/header.jsp" />
		<put-attribute name="footer" value="/WEB-INF/views/inc/footer.jsp" />
		<put-attribute name="title" value="굿팡" />
	</definition>

	<!-- 메인화면. HomeController 가 "home.index" 를 리턴함 -->
	<definition name="home.index" extends="shop">
		<put-attribute name="content" value="/WEB-INF/views/index.jsp" />
		<put-attribute name="topBanner" value="/WEB-INF/views/inc/top_banner.jsp" />
	</definition>

	<definition name="product.detail" extends="shop"> 
	   <put-attribute name="content" value="/WEB-INF/views/product.jsp" /> 
	   <!-- <put-attribute name="title" value="굿팡 - 상품상세" />  -->
	</definition>
	
	<!-- 카테고리 목록(PLP). CategoryListController 가 "category.list" 를 리턴함 -->
    <definition name="category.list" extends="shop">
             <put-attribute name="content" value="/WEB-INF/views/category_list.jsp" />
             <put-attribute name="topBanner" value="/WEB-INF/views/inc/top_banner.jsp" />
    </definition>

	<definition name="vendor.login"
		template="/WEB-INF/views/vendor/login.jsp">
	</definition>

	<definition name="vendor.*"  template="/WEB-INF/views/vendor/inc/layout.jsp">
		<put-attribute name="css" value="/vendor/inc/css/{1}.css"/>
		<put-attribute name="iconsprite" value="/WEB-INF/views/vendor/inc/icon-sprite.jsp"/>
		<put-attribute name="sidebar" value="/WEB-INF/views/vendor/inc/sidebar.jsp"/>
		<put-attribute name="topbar" value="/WEB-INF/views/vendor/inc/topbar.jsp"/>
		<put-attribute name="content" value="/WEB-INF/views/vendor/{1}.jsp"/>
	</definition>	
	

    <!-- 1. 주문/마이페이지 전용 기본 레이아웃 정의 -->
    <definition name="order-layout" template="/WEB-INF/views/inc/layout_order.jsp">
        <put-attribute name="header" value="/WEB-INF/views/inc/header.jsp" />
        <put-attribute name="footer" value="/WEB-INF/views/inc/footer.jsp" />
        <put-attribute name="rightbanner" value="/WEB-INF/views/inc/right_banner.jsp" />
        <put-attribute name="leftbanner" value="/WEB-INF/views/inc/left_banner.jsp" />
        <put-attribute name="title" value="GoodPang" />
    </definition>

    <!-- 2. 주문 목록 페이지 정의 (OrderController가 "order.order_list"를 리턴함) -->
    <definition name="order.order_list" extends="order-layout">
        <put-attribute name="css" value="/resources/css/order_list.css"/>
        <put-attribute name="content" value="/WEB-INF/views/order/order_list.jsp" />
        <put-attribute name="title" value="주문목록/배송조회 - GoodPang" />
    </definition>
    
</tiles-definitions>





