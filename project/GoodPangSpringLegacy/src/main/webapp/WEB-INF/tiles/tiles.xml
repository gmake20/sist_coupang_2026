<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC 
   "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN" 
   "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">

<tiles-definitions>

	<!-- shop 레이아웃 - 헤더 + 본문 + 푸터 페이지 추가할 때 아래 home.index 처럼 definition 만 더 
		쓰면 됨. -->
	<definition name="shop" template="/WEB-INF/views/inc/layout_shop.jsp">
		<put-attribute name="header" value="/WEB-INF/views/inc/header.jsp" />
		<put-attribute name="footer" value="/WEB-INF/views/inc/footer.jsp" />
		<put-attribute name="title" value="굿팡" />
	</definition>

	<!-- 메인화면. HomeController 가 "home.index" 를 리턴함 -->
	<definition name="home.index" extends="shop">
		<put-attribute name="content" value="/WEB-INF/views/index.jsp" />
		<put-attribute name="topBanner" value="/WEB-INF/views/inc/top_banner.jsp" />
	</definition>

	<definition name="product.detail" extends="shop"> 
	   <put-attribute name="content" value="/WEB-INF/views/product.jsp" /> 
	   <!-- <put-attribute name="title" value="굿팡 - 상품상세" />  -->
	</definition>
	
	<!-- 카테고리 목록(PLP). CategoryListController 가 "category.list" 를 리턴함 -->
    <definition name="category.list" extends="shop">
             <put-attribute name="content" value="/WEB-INF/views/category_list.jsp" />
             <put-attribute name="topBanner" value="/WEB-INF/views/inc/top_banner.jsp" />
    </definition>

	<definition name="vendor.login"
		template="/WEB-INF/views/vendor/login.jsp">
	</definition>

	<definition name="vendor.signup"
		template="/WEB-INF/views/vendor/signup.jsp">
	</definition>

	<definition name="vendor.*"  template="/WEB-INF/views/vendor/inc/layout.jsp">
		<put-attribute name="css" value="/vendor/inc/css/{1}.css"/>
		<put-attribute name="iconsprite" value="/WEB-INF/views/vendor/inc/icon-sprite.jsp"/>
		<put-attribute name="sidebar" value="/WEB-INF/views/vendor/inc/sidebar.jsp"/>
		<put-attribute name="topbar" value="/WEB-INF/views/vendor/inc/topbar.jsp"/>
		<put-attribute name="content" value="/WEB-INF/views/vendor/{1}.jsp"/>
	</definition>	
	

    <!-- 1. 주문/마이페이지 전용 기본 레이아웃 정의 -->
    <definition name="order-layout" template="/WEB-INF/views/inc/layout_order.jsp">
        <put-attribute name="header" value="/WEB-INF/views/inc/header.jsp" />
        <put-attribute name="footer" value="/WEB-INF/views/inc/footer.jsp" />
        <put-attribute name="rightbanner" value="/WEB-INF/views/inc/right_banner.jsp" />
        <put-attribute name="leftbanner" value="/WEB-INF/views/inc/left_banner.jsp" />
        <put-attribute name="title" value="GoodPang" />
    </definition>

    <!-- 2. 주문 목록 페이지 정의 (OrderController가 "order.order_list"를 리턴함) -->
    <definition name="order.order_list" extends="order-layout">
        <put-attribute name="css" value="/resources/css/order_list.css"/>
        <put-attribute name="content" value="/WEB-INF/views/order/order_list.jsp" />
        <put-attribute name="title" value="주문목록/배송조회 - GoodPang" />
    </definition>
    
    <!-- 2. 주문 목록 페이지 정의 (OrderController가 "order.order_list"를 리턴함) -->
    <definition name="order.order_detail" extends="order-layout">
        <put-attribute name="css" value="/resources/css/order_detail.css"/>
        <put-attribute name="content" value="/WEB-INF/views/order/order_detail.jsp" />
        <put-attribute name="title" value="주문목록/배송조회 - GoodPang" />
    </definition>
    
    <!-- 배송지 전용 레이아웃 -->
<definition name="address-layout"
    template="/WEB-INF/views/inc/address_layout.jsp">

    <put-attribute name="header"
        value="/WEB-INF/views/inc/header.jsp" />

    <put-attribute name="footer"
        value="/WEB-INF/views/inc/footer.jsp" />

    <put-attribute name="rightbanner"
        value="/WEB-INF/views/inc/right_banner.jsp" />

    <put-attribute name="leftbanner"
        value="/WEB-INF/views/inc/left_banner.jsp" />

    <put-attribute name="title"
        value="GoodPang" />

</definition>

	<!-- 리뷰 layout -->
<definition name="review-layout"
    template="/WEB-INF/views/inc/review_layout.jsp">

    <put-attribute name="header"
        value="/WEB-INF/views/inc/header.jsp" />

    <put-attribute name="footer"
        value="/WEB-INF/views/inc/footer.jsp" />

    <put-attribute name="rightbanner"
        value="/WEB-INF/views/inc/right_banner.jsp" />

    <put-attribute name="leftbanner"
        value="/WEB-INF/views/inc/left_banner.jsp" />

    <put-attribute name="title"
        value="GoodPang" />

</definition>

		<definition name="review.list"
	    extends="review-layout">
	
	    <put-attribute name="css"
	        value="/resources/css/review_list.css" />
	
	    <put-attribute name="content"
	        value="/WEB-INF/views/review/review_list.jsp" />
	
	    <put-attribute name="title"
	        value="GoodPang" />
	
	</definition>
	
	<definition name="review.write"
	    extends="review-layout">
	
	    <put-attribute name="css"
	        value="/resources/css/review_write.css" />
	
	    <put-attribute name="content"
	        value="/WEB-INF/views/review/review_write.jsp" />
	
	    <put-attribute name="title"
	        value="GoodPang" />
	
	</definition>


	
	<!-- 배송지 목록 -->
	<definition name="address.list"
	    extends="address-layout">
	
	    <put-attribute name="css"
	        value="/resources/css/goodpang_addressbook.css" />
	
	    <put-attribute name="content"
	        value="/WEB-INF/views/address/addressbook.jsp" />
	
	    <put-attribute name="title"
	        value="배송지 관리 - GoodPang" />
	
	</definition>
	
	
	<!-- 배송지 추가 -->
	<definition name="address.add"
	    extends="address-layout">
	
	    <put-attribute name="css"
	        value="/resources/css/address_add.css" />
	
	    <put-attribute name="content"
	        value="/WEB-INF/views/address/address_add.jsp" />
	
	    <put-attribute name="title"
	        value="배송지 추가 - GoodPang" />
	
	</definition>
	
	
	<!-- 배송지 수정 -->
	<definition name="address.edit"
	    extends="address-layout">
	
	    <put-attribute name="css"
	        value="/resources/css/address_add.css" />
	
	    <put-attribute name="content"
	        value="/WEB-INF/views/address/address_edit.jsp" />
	
	    <put-attribute name="title"
	        value="배송지 수정 - GoodPang" />
	
	</definition>
    
    <!-- 2. 주문 목록 페이지 정의 (OrderController가 "order.order_list"를 리턴함) -->
    <definition name="order.cancel_history" extends="order-layout">
        <put-attribute name="css" value="/resources/css/cancel_history.css"/>
        <put-attribute name="content" value="/WEB-INF/views/order/cancel_history.jsp" />
        <put-attribute name="title" value="주문목록/배송조회 - GoodPang" />
    </definition>
    
    <!-- tiles.xml -->
  <definition name="order.cancel_detail" extends="order-layout">
    <put-attribute name="css" value="/resources/css/cancel_detail.css"/>
    <put-attribute name="content" value="/WEB-INF/views/order/cancel_detail.jsp" />
    <put-attribute name="title" value="취소/반품/교환 상세 - GoodPang" />
  </definition>
  
  <!-- tiles.xml 에 추가 -->
<definition name="order.order_tracking" extends="order-layout">
    <put-attribute name="css" value="/resources/css/order_tracking.css"/>
    <put-attribute name="content" value="/WEB-INF/views/order/order_tracking.jsp" />
    <put-attribute name="title" value="배송 조회 - GoodPang" />
</definition>
    
	<!-- 관리자 로그인 - 레이아웃 없는 단독 화면 (AdminController.login) -->
	<definition name="admin.login"
		template="/WEB-INF/views/admin/login.jsp">
	</definition>

	<!-- 관리자 화면 - 기존 GoodPang 관리자 페이지들은 공통 레이아웃 없이 각자 단독 화면이라 JSP를 그대로 template으로 씀.
	     admin.dashboard → /WEB-INF/views/admin/dashboard.jsp -->
	<definition name="admin.*"
		template="/WEB-INF/views/admin/{1}.jsp">
	</definition>

</tiles-definitions>



