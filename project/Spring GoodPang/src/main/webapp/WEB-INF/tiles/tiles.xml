<tiles-definitions>

	<definition name="base"
		template="/WEB-INF/views/inc/layout.jsp">
		<put-attribute name="header" value="/WEB-INF/views/inc/header.jsp" />
		<put-attribute name="footer" value="/WEB-INF/views/inc/footer.jsp" />
		<put-attribute name="title"	value="SiSt Class 5 Spring Tiles" />
	</definition>

	<definition name="home.index" extends="base">
		<put-attribute name="content" value="/WEB-INF/views/index.jsp" />
	</definition>




	<definition name="*.*" template="/WEB-INF/views/{1}/inc/layout.jsp" extends="base">
		<put-attribute name="visual" value="/WEB-INF/views/{1}/inc/visual.jsp" />
		<put-attribute name="aside" value="/WEB-INF/views/{1}/inc/aside.jsp" />
		<put-attribute name="content" value="/WEB-INF/views/{1}/{2}.jsp" />
		<put-attribute name="css" value="{2}.css" />
	</definition>

