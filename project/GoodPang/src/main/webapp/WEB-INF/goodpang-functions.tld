<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">

    <description>굿팡 공용 EL 함수</description>
    <tlib-version>1.0</tlib-version>
    <short-name>img</short-name>
    <uri>/WEB-INF/goodpang-functions.tld</uri>

    <!-- ${img:url(item.thumbnailUrl)} - ImageUrl.resolve() 참고 -->
    <function>
        <name>url</name>
        <function-class>com.goodpang.util.ImageUrl</function-class>
        <function-signature>java.lang.String resolve(java.lang.String)</function-signature>
    </function>

</taglib>
